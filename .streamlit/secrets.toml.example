# Copy to .streamlit/secrets.toml locally (optional), or paste in Streamlit Cloud → Settings → Secrets

[auth]
# Optional password gate for the public URL
password = "change-me"

[cloud]
# GitHub Personal Access Token with scope: gist
github_token = "ghp_xxxxxxxx"
# Create a secret gist with a file named progress.json (can be "{}") and paste its id
gist_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
